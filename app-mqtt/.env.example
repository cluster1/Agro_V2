# Time zone used to write and read datetime values: "local" (server zone, default), "Z" or "+HH:MM".
# Set it (e.g. +07:00) when devices send a zone-less "datetime" in local time, so stored times do not
# depend on the server time zone. Leave unset to keep the previous behaviour.
# DB_TIMEZONE=+07:00
